PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/connectia
JWT_ACCESS_SECRET=connectia_dev_access_change_me
JWT_REFRESH_SECRET=connectia_dev_refresh_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# §1 Login SSO (Microsoft / Google / Okta) — OAuth2 Auth Code + PKCE
# LOGIN_ENTRA_TENANT_ID=common
# LOGIN_ENTRA_CLIENT_ID=
# LOGIN_ENTRA_CLIENT_SECRET=
# LOGIN_ENTRA_REDIRECT_URI=http://localhost:4000/api/auth/sso/microsoft/callback
# LOGIN_GOOGLE_CLIENT_ID=
# LOGIN_GOOGLE_CLIENT_SECRET=
# LOGIN_GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/sso/google/callback
# LOGIN_OKTA_DOMAIN=tudominio.okta.com
# LOGIN_OKTA_ISSUER=https://tudominio.okta.com/oauth2/default
# LOGIN_OKTA_CLIENT_ID=
# LOGIN_OKTA_CLIENT_SECRET=
# LOGIN_OKTA_REDIRECT_URI=http://localhost:4000/api/auth/sso/okta/callback
# LOGIN_2FA_TTL_MINUTES=10
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# LOGIN_SMS_DEV_LOG=1
# LOGIN_TOKEN_SECRET=
# LOGIN_LEGACY_SECRET=

# Mail (mismo patrón que Hiryx / Gmail app password)
EMAIL_USER=
EMAIL_PASSWORD=
# EMAIL_FROM=  # opcional; default = EMAIL_USER
# COM_EMAIL_DEV_LOG=1  # Ola 28: en local sin SMTP marca envíos COM como ok (dev)
PASSWORD_RESET_EXPIRY_MINUTES=60
BRAND_NAME=Connectia

# WhatsApp Business / Meta Cloud API (Ola 28 · 28.COM.07)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=  # challenge webhook GET /api/webhooks/whatsapp
# COM_WA_DEV_LOG=1  # sin credenciales: log + success en no-prod

# Web Push (VAPID). Si faltan, el backend genera claves efímeras en desarrollo.
# Generá un par estable con: node -e "import('web-push').then(w=>console.log(w.default.generateVAPIDKeys()))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@tu-dominio.com

# Documentos SAP (stub 17.05) — opcional
# SAP_DOCS_ENABLED=false
# SAP_DOCS_BASE_URL=https://sap.example.com/api
# SAP_DOCS_API_KEY=

# Panel ECR supervisores (Ola 31) — secretos solo en backend
# ECR_SUPERVISORS_API=https://example.com
# ECR_SUPERVISORS_API_KEY=

# Ausentismo ECR (12.04) — secretos solo en backend
# Sin estas vars: mock si el tenant tiene pack.ecr / asistencia.ecr / integracion.ausentismo.ecr
# ECR_AUSENTISMO_API=https://ausentismo.ecrgroup.cl
# ECR_AUSENTISMO_API_KEY=
# ECR_AUSENTISMO_BEARER=
# Paths opcionales (defaults REST v1):
# ECR_AUSENTISMO_CREATE_PATH=/api/v1/ausentismos
# ECR_AUSENTISMO_UPDATE_PATH=/api/v1/ausentismos/:id
# ECR_AUSENTISMO_CANCEL_PATH=/api/v1/ausentismos/:id/cancelar


# §27.08 Google Workspace Directory (import usuarios)
# Service account con domain-wide delegation + scope admin.directory.user.readonly
# GOOGLE_WORKSPACE_CLIENT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_WORKSPACE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_WORKSPACE_SUBJECT=admin@tudominio.com
# GOOGLE_WORKSPACE_DOMAIN=tudominio.com
# Alternativa: GOOGLE_WORKSPACE_CREDENTIALS_JSON={"client_email":"...","private_key":"..."}

# §27.09 Microsoft Entra ID (Graph Users) — app registration client credentials
# Permiso Application: User.Read.All (admin consent)
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# §6 Calendario personal — Microsoft (delegado, Authorization Code + PKCE)
# Scopes: offline_access Calendars.ReadWrite (lectura + escritura bidireccional)
# MS_CALENDAR_CLIENT_ID=
# MS_CALENDAR_CLIENT_SECRET=
# MS_CALENDAR_REDIRECT_URI=http://localhost:4000/api/calendar/callback/outlook
# MS_CALENDAR_SCOPES=offline_access openid email profile Calendars.ReadWrite

# §6 Calendario personal — Google (delegado, Authorization Code + PKCE)
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/calendar/callback/google
# GOOGLE_CALENDAR_SCOPES=openid email profile https://www.googleapis.com/auth/calendar

# Cifrado de tokens OAuth en Mongo (32 bytes base64). Si falta, se deriva de JWT_ACCESS_SECRET.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CALENDAR_TOKEN_ENC_KEY=

# IA (OpenAI y/o Anthropic)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Búsqueda web opcional para "Desde la web" (si no hay key → DuckDuckGo)
# SERPER_API_KEY=
# BRAVE_SEARCH_API_KEY=
