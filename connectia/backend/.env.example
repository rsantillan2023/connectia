PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/connectia
JWT_ACCESS_SECRET=connectia_dev_access_change_me
JWT_REFRESH_SECRET=connectia_dev_refresh_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# Mail (mismo patrón que Hiryx / Gmail app password)
EMAIL_USER=
EMAIL_PASSWORD=
# EMAIL_FROM=  # opcional; default = EMAIL_USER
PASSWORD_RESET_EXPIRY_MINUTES=60
BRAND_NAME=Connectia

# Web Push (VAPID). Si faltan, el backend genera claves efímeras en desarrollo.
# Generá un par estable con: node -e "import('web-push').then(w=>console.log(w.default.generateVAPIDKeys()))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@tu-dominio.com

# Documentos SAP (stub 17.05) — opcional
# SAP_DOCS_ENABLED=false
# SAP_DOCS_BASE_URL=https://sap.example.com/api
# SAP_DOCS_API_KEY=

# Hub SSO (stub 46.04) — opcional
# SSO_DEFAULT_BASE_URL=https://sso.example.com/launch
# SSO_DEFAULT_SECRET=change_me
# SSO_ADAPTERS_JSON={"mi-adapter":{"baseUrl":"https://...","secretEnv":"SSO_MI_SECRET"}}

# §27.08 Google Workspace Directory (import usuarios)
# Service account con domain-wide delegation + scope admin.directory.user.readonly
# GOOGLE_WORKSPACE_CLIENT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_WORKSPACE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_WORKSPACE_SUBJECT=admin@tudominio.com
# GOOGLE_WORKSPACE_DOMAIN=tudominio.com
# Alternativa: GOOGLE_WORKSPACE_CREDENTIALS_JSON={"client_email":"...","private_key":"..."}

# §27.09 Microsoft Entra ID (Graph Users) — app registration client credentials
# Permiso Application: User.Read.All (admin consent)
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# §6 Calendario personal — Microsoft (delegado, Authorization Code + PKCE)
# Scopes: offline_access Calendars.ReadWrite (lectura + escritura bidireccional)
# MS_CALENDAR_CLIENT_ID=
# MS_CALENDAR_CLIENT_SECRET=
# MS_CALENDAR_REDIRECT_URI=http://localhost:4000/api/calendar/callback/outlook
# MS_CALENDAR_SCOPES=offline_access openid email profile Calendars.ReadWrite

# §6 Calendario personal — Google (delegado, Authorization Code + PKCE)
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/calendar/callback/google
# GOOGLE_CALENDAR_SCOPES=openid email profile https://www.googleapis.com/auth/calendar

# Cifrado de tokens OAuth en Mongo (32 bytes base64). Si falta, se deriva de JWT_ACCESS_SECRET.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CALENDAR_TOKEN_ENC_KEY=

# IA (OpenAI y/o Anthropic)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Búsqueda web opcional para "Desde la web" (si no hay key → DuckDuckGo)
# SERPER_API_KEY=
# BRAVE_SEARCH_API_KEY=
